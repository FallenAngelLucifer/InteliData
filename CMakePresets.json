{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64-debug",
      "displayName": "x64 Debug (Visual Studio MSVC + Ninja)",
      "description": "Entorno nativo de depuración para Visual Studio 2022 Open Folder",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "INTELIDATA_BUILD_TESTS": "ON",
        "INTELIDATA_ENABLE_AVX2": "ON",
        "INTELIDATA_ENABLE_DUCKDB": "ON",
        "INTELIDATA_BUILD_GUI": "ON"
      },
      "environment": {
        "INTELIDATA_ROOT": "${sourceDir}",
        "WORKSPACE_ROOT": "${sourceDir}"
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "x64 Release (Visual Studio MSVC + Ninja)",
      "description": "Entorno optimizado de producción para Visual Studio 2022 Open Folder",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "INTELIDATA_BUILD_TESTS": "ON",
        "INTELIDATA_ENABLE_AVX2": "ON",
        "INTELIDATA_ENABLE_DUCKDB": "ON",
        "INTELIDATA_BUILD_GUI": "ON"
      },
      "environment": {
        "INTELIDATA_ROOT": "${sourceDir}",
        "WORKSPACE_ROOT": "${sourceDir}"
      }
    },
    {
      "name": "linux-x64-release",
      "displayName": "Linux x64 Release (GCC/Clang)",
      "description": "Compilación optimizada bare-metal para Linux",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "INTELIDATA_BUILD_TESTS": "ON",
        "INTELIDATA_ENABLE_AVX2": "ON",
        "INTELIDATA_ENABLE_DUCKDB": "ON",
        "INTELIDATA_BUILD_GUI": "ON"
      },
      "environment": {
        "INTELIDATA_ROOT": "${sourceDir}",
        "WORKSPACE_ROOT": "${sourceDir}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-windows-debug",
      "displayName": "Build x64 Debug",
      "configurePreset": "windows-x64-debug"
    },
    {
      "name": "build-windows-release",
      "displayName": "Build x64 Release",
      "configurePreset": "windows-x64-release"
    },
    {
      "name": "build-linux-release",
      "displayName": "Build Linux Release",
      "configurePreset": "linux-x64-release"
    }
  ],
  "testPresets": [
    {
      "name": "test-windows-release",
      "displayName": "Test x64 Release",
      "configurePreset": "windows-x64-release"
    },
    {
      "name": "test-linux-release",
      "displayName": "Test Linux Release",
      "configurePreset": "linux-x64-release"
    }
  ]
}
